# KAnime — .htaccess (InfinityFree Compatible)
# CATATAN: php_value DIHAPUS — InfinityFree pakai PHP-FPM, bukan mod_php,
#          sehingga php_value menyebabkan 500 Error.

Options -Indexes

# Cegah akses langsung ke file sensitif
<FilesMatch "\.(sql|env|log)$">
    Require all denied
</FilesMatch>

# Block akses ke script migrate
<FilesMatch "^migrate_">
    Require all denied
</FilesMatch>

# Gzip (pakai IfModule agar aman jika modul tidak ada)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# Cache assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
